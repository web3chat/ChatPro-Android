<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.fzm.widget.CustomTitleBar
        android:id="@+id/ctb_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/redpacket_red_top"
        app:left_icon="@drawable/biz_ic_back_white"
        app:right_text="红包记录"
        app:right_text_color="#FFDF5F"
        app:right_text_size="14sp" />

    <!--头部：浅红→红 渐变（高 wrap_content，底部与下方波浪图同色，衔接无缝）-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/redpacket_bg_detail_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="8dp"
        android:paddingEnd="15dp"
        android:paddingBottom="16dp">

        <com.fzm.chat.biz.widget.ChatAvatarView
            android:id="@+id/iv_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/default_avatar_round" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="5dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:drawableEnd="@mipmap/icon_packet_type_luck2"
            tools:text="丹丹的红包" />

        <TextView
            android:id="@+id/tv_remark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="恭喜发财，大吉大利！" />

        <TextView
            android:id="@+id/tv_packet_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            tools:text="红包ID 123456789" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/specialtext"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            tools:text="1.23CHAT" />

        <TextView
            android:id="@+id/tv_go_asset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/redpacket_shape_link_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/red_packet_saved_to_wallet"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scaleType="fitXY"
        android:src="@mipmap/img_receive_info_top" />

    <!--领取统计（小红点 + 灰色文案）+ 分隔线-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/redpacket_shape_dot" />

        <TextView
            android:id="@+id/tv_receive_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="@color/biz_text_grey_light"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/biz_color_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_receive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_packet_receive_record" />
</LinearLayout>