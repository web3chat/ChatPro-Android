<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transfer_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/biz_color_primary">

        <RelativeLayout
            android:id="@+id/rl_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/biz_color_primary_dark">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/biz_ic_back_dark" />

            <TextView
                android:id="@+id/tv_transfer_type"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:textColor="@color/biz_text_grey_dark"
                android:textSize="20sp"
                app:drawableEndCompat="@drawable/ic_arrow_right"
                tools:text="BTY转账" />
        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_title"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_from_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="45dp">

                <com.fzm.chat.biz.widget.ChatAvatarView
                    android:id="@+id/iv_avatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@mipmap/default_avatar_round" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/wallet_nickname_label"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="middle"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textSize="14sp"
                    tools:text="15hdhuhuudusbcudchhdhuhuudusbcudch" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:bl_corners_topLeftRadius="30dp"
                app:bl_corners_topRightRadius="30dp"
                app:bl_solid_color="@color/biz_color_primary"
                tools:ignore="MissingPrefix">

                <LinearLayout
                    android:id="@+id/ll_goto_other_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="5dp"
                            android:gravity="center_vertical"
                            android:text="@string/wallet_receiver_label"
                            android:textColor="@color/biz_text_grey_dark"
                            android:textSize="@dimen/sp_14"
                            app:drawableStartCompat="@drawable/ic_block_accent" />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/iv_contact"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="15dp"
                            android:src="@mipmap/icon_out_contacts" />

                        <ImageView
                            android:id="@+id/iv_scan"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="right"
                            android:layout_marginStart="15dp"
                            android:src="@drawable/ic_wallet_scan" />

                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_to_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="13dp"
                        android:background="@null"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:background="#D9DCE9" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:drawablePadding="5dp"
                        android:text="@string/wallet_transfer_amount_label"
                        android:textColor="@color/biz_text_grey_dark"
                        app:drawableStartCompat="@drawable/ic_block_accent" />

                    <TextView
                        android:id="@+id/tv_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/wallet_balance_default"
                        android:textColor="@color/biz_color_accent" />
                </RelativeLayout>


                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="10dp"
                    app:bl_corners_radius="14dp"
                    app:bl_solid_color="@color/biz_color_primary_dark">

                    <EditText
                        android:id="@+id/et_amount"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/wallet_amount_hint"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="15dp"
                        android:textColor="@color/biz_text_grey_dark"
                        android:textColorHint="@color/biz_text_grey_light"
                        android:textCursorDrawable="@drawable/ic_cursor_accent" />
                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:drawablePadding="5dp"
                        android:text="@string/wallet_fee_label"
                        android:textColor="@color/biz_text_grey_dark"
                        app:drawableStartCompat="@drawable/ic_block_accent" />

                    <TextView
                        android:id="@+id/tv_fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="--"
                        android:textColor="@color/biz_text_grey_light" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_remote_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp">

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/ll_remote_note_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="5dp"
                            android:text="@string/wallet_tx_remote_note_label"
                            android:textColor="@color/biz_text_grey_dark"
                            app:drawableStartCompat="@drawable/ic_block_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wallet_optional_label"
                            android:textColor="@color/biz_text_grey_light" />

                        <ImageView
                            android:id="@+id/remote_note_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ic_help" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_remote_note"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_remote_note_tips"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/edittext_bg_selector"
                        android:maxLength="60"
                        android:minHeight="40dp"
                        android:textCursorDrawable="@drawable/ic_cursor_accent" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_local_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ll_local_note_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="5dp"
                            android:text="@string/wallet_tx_local_note_label"
                            android:textColor="@color/biz_text_grey_dark"
                            app:drawableStartCompat="@drawable/ic_block_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wallet_optional_label"
                            android:textColor="@color/biz_text_grey_light" />

                        <ImageView
                            android:id="@+id/local_note_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ic_help" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_local_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_local_note_tips"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/edittext_bg_selector"
                        android:maxLength="60"
                        android:minHeight="40dp"
                        android:textCursorDrawable="@drawable/ic_cursor_accent" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_bottom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:background="@color/biz_color_primary">

            <TextView
                android:id="@+id/tv_submit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_btn_accent_round"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="确认转账" />
        </RelativeLayout>
    </RelativeLayout>

    <include
        android:id="@+id/drawer_content"
        layout="@layout/transfer_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>