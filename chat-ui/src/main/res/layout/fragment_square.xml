<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_filter_all"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_filter_person"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_filter_person"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_filter_official"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_filter_official"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />

                    <!--两组筛选的分隔（左=发帖者类型，右=官方帖标签）-->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/biz_color_divider" />

                    <!--官方帖标签分区（tag=公告 / 消息 / 活动，可横向滚动）-->
                    <TextView
                        android:id="@+id/tv_tag_announcement"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_tag_announcement"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_tag_news"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_tag_message"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_tag_activity"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_square_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/square_tag_activity"
                        android:textColor="@color/square_filter_text_color"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!--金标公众号墙（暂隐藏入口：正式服 /officials 尚未部署；恢复时去掉 visibility 即可）-->
            <ImageView
                android:id="@+id/iv_gold_entry"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/square_gold_title"
                android:padding="4dp"
                android:src="@drawable/square_ic_gold"
                android:visibility="gone"
                tools:visibility="gone" />

            <!--评论与回复收件箱（有新消息时角标显示未读数）-->
            <FrameLayout
                android:id="@+id/fl_inbox_entry"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp">

                <ImageView
                    android:id="@+id/iv_inbox_entry"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/square_inbox_title"
                    android:padding="5dp"
                    android:src="@drawable/square_ic_inbox"
                    android:tint="@color/gray_33" />

                <TextView
                    android:id="@+id/tv_inbox_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/shape_square_badge"
                    android:gravity="center"
                    android:minWidth="14dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>

            <ImageView
                android:id="@+id/iv_my_entry"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/ripple_square_my_entry"
                android:contentDescription="@string/square_my_profile"
                android:scaleType="fitCenter"
                android:src="@drawable/square_ic_my_avatar" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/biz_color_divider" />

        <!--广场流：最新 / 热门（近 7 天）/ 关注（我关注的人与公众号）-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_feed_latest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_feed_latest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/square_feed_latest"
                    android:textColor="@color/biz_color_accent"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/v_feed_latest"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_square_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_feed_hot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_feed_hot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/square_feed_hot"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/v_feed_hot"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_square_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_feed_following"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_feed_following"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/square_feed_following"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/v_feed_following"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_square_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/biz_color_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_square"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="76dp" />
            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

            <!--骨架屏：首屏 / 切换筛选时占位（不显示下拉刷新动画，也不闪「暂无内容」）-->
            <LinearLayout
                android:id="@+id/ll_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <include layout="@layout/layout_square_skeleton_item" />

                <include layout="@layout/layout_square_skeleton_item" />

                <include layout="@layout/layout_square_skeleton_item" />
            </LinearLayout>

            <!--广场完全关闭（canRead=false）：不拉帖，全屏展示运营文案（文案原样展示，不写死）-->
            <LinearLayout
                android:id="@+id/ll_closed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_closed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="14sp"
                    tools:text="广场功能已经关闭" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_publish"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_square_fab"
        android:contentDescription="@string/square_action_publish"
        android:elevation="4dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/square_ic_publish" />
</FrameLayout>
