<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/img_chat_send"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxWidth="240dp"
        android:minHeight="40dp"
        android:paddingLeft="15dp"
        android:paddingTop="9dp"
        android:paddingRight="15dp"
        android:paddingBottom="9dp"
        android:textDirection="locale"
        android:textSize="16sp"
        tools:text="这里是文本消息，当对方没 有点击查看时，就一直显示 锁的图标，对方开始倒计时 发送就消失" />

    <!-- 链接卡片：文本里命中 [[LINK_CARD]] 时替换正文显示 -->
    <LinearLayout
        android:id="@+id/ll_link_card"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_link_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gray_33"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_card_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_card_thumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/square_ic_md_link" />
        </LinearLayout>

        <View
            android:id="@+id/view_card_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:background="#E6E8EB" />

        <LinearLayout
            android:id="@+id/ll_card_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/square_ic_md_link" />

            <TextView
                android:id="@+id/tv_card_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_8E92A3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 广场帖子卡片：正文里命中 [[SQUARE_CARD]] 时替换正文显示（对齐 iOS 样式） -->
    <LinearLayout
        android:id="@+id/ll_square_card"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_square_card"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 头部：品牌 logo + 作者 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/ic_square_tanxin" />

            <TextView
                android:id="@+id/tv_square_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/gray_33"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_square_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/color_8E92A3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 正文 + 右侧配图 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/tv_square_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/gray_33"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_square_image"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_square_card_thumb"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 底部：来源 + 查看详情 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/square_card_from"
                android:textColor="@color/color_8E92A3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/square_card_view_detail"
                android:textColor="@color/color_8E92A3"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/square_ic_arrow_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- 微信样式：译文块，显示在原文下方 -->
    <LinearLayout
        android:id="@+id/ll_translate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_translate_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_popup_option_translate"
            android:textColor="@color/color_8E92A3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_translation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_translate_block_receive"
            android:lineSpacingExtra="2dp"
            android:maxWidth="210dp"
            android:padding="8dp"
            android:textColor="@color/gray_33"
            android:textDirection="locale"
            android:textSize="16sp"
            tools:text="This is the translated message content." />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp"
        android:text="@string/chat_fold"
        android:textColor="@color/biz_color_accent"
        android:visibility="gone" />
</LinearLayout>
