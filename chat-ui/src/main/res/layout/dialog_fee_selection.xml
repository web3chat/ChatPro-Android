<?xml version="1.0" encoding="utf-8"?>
<!-- 选择网络费 BottomSheet 弹窗 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nsv_fee_selection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_top_rounded"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 拖拽指示条 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- 标题行: 选择网络费 + 关闭按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tv_fee_selection_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/select_network_fee"
                android:textColor="@color/biz_text_grey_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fee_selection_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@drawable/ic_close_chain_menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- 费用选项列表容器 -->
        <LinearLayout
            android:id="@+id/ll_fee_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical" />

        <!-- 自定义Gas输入区域 (默认隐藏) -->
        <LinearLayout
            android:id="@+id/ll_custom_gas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Gas Price 和 Gas Limit 输入行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_custom_gas"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card_10"
                    android:hint="Gas Price (Gwei)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textColorHint="@color/biz_text_grey_light"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_custom_gas_limit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card_10"
                    android:hint="Gas Limit"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textColorHint="@color/biz_text_grey_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 确认按钮由代码动态添加 -->
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
