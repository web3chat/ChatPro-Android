<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <com.fzm.widget.CustomTitleBar
        android:id="@+id/ctb_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:left_icon="@drawable/biz_ic_back_dark"
        app:right_text="@string/square_action_delete"
        app:right_text_color="@color/color_8E92A3"
        app:right_text_size="15sp"
        app:title_text="@string/square_detail_title"
        app:title_text_color="@color/gray_33"
        app:title_text_size="17sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp">

                <com.fzm.chat.biz.widget.ChatAvatarView
                    android:id="@+id/iv_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!--昵称：固定最大宽度（约 7 个汉字），超出显示省略号；优先保证右侧「关注」按钮完整展示-->
                        <TextView
                            android:id="@+id/tv_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="104dp"
                            android:textColor="@color/biz_text_grey_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="谈信资讯" />

                        <!--金标公众号（紧跟昵称，在身份标签之前）-->
                        <ImageView
                            android:id="@+id/iv_gold"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/square_ic_gold"
                            android:visibility="gone"
                            tools:ignore="ContentDescription"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_official_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/shape_square_official_tag"
                            android:gravity="center"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:text="@string/square_official_tag"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <!--官方帖标签（公告 / 消息 / 活动）-->
                        <TextView
                            android:id="@+id/tv_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/shape_square_post_tag"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="@color/biz_color_accent"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:text="公告"
                            tools:visibility="visible" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!--关注作者（自己的帖不显示；状态取自关注列表内存缓存）-->
                        <TextView
                            android:id="@+id/tv_follow"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_square_follow_btn"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:minWidth="58dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/square_follow"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/biz_red_tips"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="审核未通过"
                        tools:visibility="visible" />

                    <!--运营置顶角标（文章置顶：跟在正文上方，不与作者昵称同行）-->
                    <TextView
                        android:id="@+id/tv_pinned"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/shape_square_pinned_tag"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/square_pinned"
                        android:textColor="#F57C00"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/gray_33"
                        android:textIsSelectable="true"
                        android:textSize="16sp"
                        tools:text="广场第一帖" />

                    <LinearLayout
                        android:id="@+id/ll_images"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <!--发帖时间（文章右下角）-->
                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/biz_text_grey_light"
                        android:textSize="12sp"
                        tools:text="10 分钟前" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/square_ic_view"
                            android:tint="@color/biz_text_grey_light"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tv_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/biz_text_grey_light"
                            android:textSize="12sp"
                            tools:text="88" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/ll_comment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/square_ic_comment"
                                android:tint="@color/biz_text_grey_light"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/tv_comment_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/biz_text_grey_light"
                                android:textSize="12sp"
                                tools:text="3" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_like"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/square_ic_like"
                                android:tint="@color/biz_text_grey_light"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/tv_like_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/biz_text_grey_light"
                                android:textSize="12sp"
                                tools:text="10" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/square_ic_share"
                                android:tint="@color/biz_text_grey_light"
                                tools:ignore="ContentDescription" />
                        </LinearLayout>

                        <!--编辑（仅自己的帖且在可编辑时限内）-->
                        <TextView
                            android:id="@+id/tv_edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:padding="4dp"
                            android:text="@string/square_action_edit"
                            android:textColor="@color/color_8E92A3"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_comment_switch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/square_allow_comment"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textSize="15sp" />

                <com.fzm.widget.SwitchView
                    android:id="@+id/sv_comment"
                    android:layout_width="60dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_comments_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/square_comments_title"
                    android:textColor="@color/biz_text_grey_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_empty_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/square_no_comment"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_comments_closed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/square_comments_closed"
                    android:textColor="@color/color_8E92A3"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_comment_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!--回复对象提示：点某条评论/回复后出现，点「取消」退出回复-->
        <LinearLayout
            android:id="@+id/ll_reply_hint"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@color/color_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_reply_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_8E92A3"
                android:textSize="12sp"
                tools:text="回复 @小明" />

            <TextView
                android:id="@+id/tv_reply_cancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/square_reply_cancel"
                android:textColor="@color/biz_color_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="15dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/shape_square_chip"
                android:hint="@string/square_comment_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="600"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_33"
                android:textColorHint="@color/color_8E92A3"
                android:textSize="14sp"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_square_publish"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/square_action_send"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
