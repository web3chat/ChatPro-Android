<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/fl_call_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_call_minimize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_call_control"
            android:contentDescription="@string/chat_call_window_minimize"
            android:scaleType="center"
            android:src="@drawable/ic_call_minimize" />

        <ImageView
            android:id="@+id/iv_call_hangup"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_call_control_hangup"
            android:contentDescription="@string/chat_call_window_hangup"
            android:scaleType="center"
            android:src="@drawable/ic_call_hangup" />
    </LinearLayout>
</FrameLayout>
