<?xml version="1.0" encoding="utf-8"?>
<!--楼中楼回复行：挂在所属一级评论下面，缩进对齐（无头像）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="58dp"
    android:paddingTop="6dp"
    android:paddingEnd="15dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_reply_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:textColor="@color/biz_text_grey_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="小明" />

        <TextView
            android:id="@+id/tv_reply_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/square_reply_label"
            android:textColor="@color/color_8E92A3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_reply_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:textColor="@color/biz_color_accent"
            android:textSize="13sp"
            tools:text="小红" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_reply_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/square_action_delete"
            android:textColor="@color/color_8E92A3"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_reply_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/biz_text_grey_light"
            android:textSize="11sp"
            tools:text="1 小时前" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_reply_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/gray_33"
        android:textSize="14sp"
        tools:text="同意" />
</LinearLayout>
