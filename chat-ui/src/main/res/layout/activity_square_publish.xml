<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.fzm.widget.CustomTitleBar
            android:id="@+id/ctb_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:left_icon="@drawable/biz_ic_back_dark"
            app:right_text="@string/square_action_publish"
            app:right_text_color="@color/biz_color_accent"
            app:right_text_size="15sp"
            app:title_text="@string/square_publish_title"
            app:title_text_color="@color/gray_33"
            app:title_text_size="17sp" />

        <!-- Markdown 编辑工具栏（图标在代码中填充；固定在标题栏下方，不随内容滚动） -->
        <LinearLayout
            android:id="@+id/ll_md_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_md_tools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@color/biz_color_divider" />

            <TextView
                android:id="@+id/tv_md_preview"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_square_md_preview_btn"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/square_md_preview"
                android:textColor="@color/biz_color_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/biz_color_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/et_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/square_publish_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="5000"
                    android:minHeight="140dp"
                    android:paddingStart="15dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp"
                    android:textColor="@color/gray_33"
                    android:textColorHint="@color/color_8E92A3"
                    android:textSize="16sp"
                    tools:ignore="Autofill" />

                <LinearLayout
                    android:id="@+id/ll_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp" />

                <LinearLayout
                    android:id="@+id/ll_comment_switch"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/shape_square_soft_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/square_allow_comment"
                        android:textColor="@color/biz_text_grey_dark"
                        android:textSize="15sp" />

                    <com.fzm.widget.SwitchView
                        android:id="@+id/sv_comment"
                        android:layout_width="60dp"
                        android:layout_height="30dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/biz_color_accent" />
    </LinearLayout>
</FrameLayout>
